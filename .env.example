# Mars Turizm chatbot - ayarlar. Bu dosyayi .env olarak kopyala; sadece degistirmek istediklerini birak.
# Bos birakilan veya silinen anahtar ayarlar.py icindeki varsayilani kullanir.

# Ollama sunucusunun adresi
OLLAMA_HOST=http://127.0.0.1:11434
# Cevabi ureten sohbet modeli
LLM_MODEL=gemma4:latest
# Metinleri vektore ceviren embedding modeli
EMBED_MODEL=bge-m3
# Yaraticilik (0 = deterministik, 1 = serbest)
TEMPERATURE=0.6
# Modelin "dusunme" modu (1/true = acik)
THINK=false
# Baglam penceresi (token)
NUM_CTX=8192
# Modelin bellekte kalma suresi
KEEP_ALIVE=30m
# Soru basina getirilen en alakali parca sayisi
TOP_K=3
# RAG benzerlik esigi (eval_rag.py taramasiyla olculdu)
RAG_ESIK=0.40
# Tekrar eden soru benzerlik esigi (gecici)
TEKRAR_ESIK=0.92
# Modele gonderilen gecmis sohbet turu sayisi
GECMIS_TUR=10
# Ollama paralel yuva sayisi
PARALEL_YUVA=2
# Kullanici sorusu en fazla kac karakter
SORU_MAX=500
# Erisim sifresi (bos veya SIFRE_MIN'den kisa = uygulama baslamaz, KARARLAR K-18)
ERISIM_SIFRESI=
# Sifrenin en az uzunlugu
SIFRE_MIN=8
# Oturum basina yanlis sifre denemesi; sonra oturum kapanir
SIFRE_DENEME_MAX=8
# Tum oturumlarda pencere icinde izin verilen yanlis deneme; fazlasi her denemeyi yavaslatir
GENEL_DENEME_MAX=30
# Genel sayacin penceresi (saniye)
GENEL_PENCERE_SN=600
# Sinir asildiginda tum oturumlarda bu kadar saniyede tek deneme degerlendirilir; dogru sifre yine girer
GENEL_YAVASLATMA_SN=5
# Sinir asildiginda sirada bekleyebilecek en fazla deneme; fazlasi "sira dolu" ile hemen reddedilir
GENEL_BEKLEYEN_MAX=5
